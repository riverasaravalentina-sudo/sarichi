{
  "name": "sarichi-rifa-qa",
  "version": "1.0.0",
  "description": "Suite Playwright de validación de la rifa Garfield (corre contra producción)",
  "private": true,
  "scripts": {
    "test": "playwright test --reporter=list",
    "test:headed": "playwright test --headed",
